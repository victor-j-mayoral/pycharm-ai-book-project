# TypeScript fonts: publish only the compiled JavaScript
tsconfig.json

# Dependencies and development files
.vscode/
.git/
.github/
.gitignore

# Tests and tooling configuration
**/*.test.ts
**/*.spec.ts
coverage/
.eslint*
.prettier*
.vscode-test/

# Development documentation (keeps README and CHANGELOG)
docs/
CONTRIBUTING.md

# Generated files that are not needed at the end in packaging
*.map
*.log

# Local configuration or secret files (Python)
.env
.env.*